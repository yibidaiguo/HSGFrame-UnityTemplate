{
  "_说明": "资产规格基线：资产类型 → 默认规格 / 落点 / 命名模式 / 机检项。模板发，项目层与业务层就近覆盖。可覆盖清单之外的键只许收紧不许放宽（创作管线子文档 07 §二）。",
  "版本": "1.0.0",
  "资产类型": {
    "图标": {
      "域": "资产.生图",
      "规格": {
        "宽": 256,
        "高": 256,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/ResourceArt/Icons/",
      "命名模式": "^icon_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ]
    },
    "界面底图": {
      "域": "资产.生图",
      "规格": {
        "宽": 1080,
        "高": 1920,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": false
      },
      "落点": "Assets/Game/ResourceArt/UI/",
      "命名模式": "^ui_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高",
        "规格.需要透明"
      ],
      "_说明": "UI 类图一律透明底：UI 图要叠在界面上，带底色的图一进 Unity 就是一块方块。"
    },
    "立绘": {
      "域": "资产.生图",
      "规格": {
        "宽": 1024,
        "高": 1024,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/ResourceArt/Portraits/",
      "命名模式": "^portrait_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ]
    },
    "道具模型": {
      "域": "资产.模型",
      "规格": {
        "最大面数": 3000,
        "格式": "FBX",
        "单位": "米",
        "轴心": "中心",
        "最大材质数": 2,
        "贴图尺寸": 1024,
        "包围盒上限米": 5,
        "最大骨骼数": 0
      },
      "落点": "Assets/Game/ResourceArt/Models/Props/",
      "命名模式": "^prop_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.最大面数",
        "规格.最大材质数",
        "规格.贴图尺寸",
        "规格.最大骨骼数"
      ]
    },
    "角色模型": {
      "域": "资产.模型",
      "规格": {
        "最大面数": 15000,
        "格式": "FBX",
        "单位": "米",
        "轴心": "脚底",
        "最大材质数": 4,
        "贴图尺寸": 2048,
        "包围盒上限米": 3,
        "最大骨骼数": 120
      },
      "落点": "Assets/Game/ResourceArt/Models/Characters/",
      "命名模式": "^char_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.最大面数",
        "规格.最大材质数",
        "规格.贴图尺寸",
        "规格.最大骨骼数"
      ]
    },
    "UI元素": {
      "域": "资产.生图",
      "_说明": "从界面设计图拆出来的单个元素（按钮、图标、面板底、进度条…）。一元素一张透明底 PNG，进模块的 UI 图集。层的来源是面板定义 UI/Definitions/<面板>.uidef.json 的元素清单。",
      "规格": {
        "宽": 512,
        "高": 512,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/ResourceArt/UI/Elements/",
      "命名模式": "^ui_[a-z0-9_]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ]
    }
  }
}
