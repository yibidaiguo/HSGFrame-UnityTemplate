// 夜间构建：十秒级门禁两步 + Unity 真编译，每日定时跑，耗时按分钟计。
// 触发时机：每晚定时（如凌晨），产出完整包并做冒烟。
// 失败意味着：夜间编译或冒烟挂了，第二天早上必须有人处理，否则影响后续开发。
//
// 步骤与 Pipelines/pipelines.json 里的「夜间构建」逐条对应。
// Unity 那一步要求编辑器没有占着同一个工程（Unity 会锁目录）。

pipeline {
    agent any
    stages {
        stage('dotnet build') {
            steps {
                bat 'dotnet build Solutions/Template.sln --nologo'
            }
        }
        stage('全量门禁') {
            steps {
                bat 'pwsh -NoProfile -File Tools/Gates/gate.ps1'
            }
        }
        // 需要 Unity：batchmode 冷启动一次并确认工程编译通过。
        stage('Unity 真编译') {
            steps {
                bat 'pwsh -NoProfile -File Tools/Cli/unity-cmd.ps1 -ExecuteMethod Template.Toolkit.Editor.CompileCheckEntry.Run -TimeoutMinutes 40'
            }
        }
    }
}
