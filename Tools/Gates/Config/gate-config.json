{
  "abbreviationBlacklist": [
    "Mgr",
    "Cfg",
    "Svc",
    "Btn",
    "Idx",
    "Tmp",
    "Utils",
    "Ctx",
    "Param",
    "Attr",
    "Conf"
  ],
  "directoryNameBlacklist": [
    "misc",
    "common",
    "utils",
    "helper",
    "stuff",
    "temp",
    "new"
  ],
  "directoryNamePattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
  "documentLineLimit": 200,
  "documentExemptions": [],
  "changedPathWhitelist": [],
  "testFileGlobs": [
    "Solutions/*.Tests/*.cs"
  ],
  "sourceScanSkipSegments": [
    "HybridCLRData",
    "PackageCache",
    "Build",
    "Logs"
  ]
}
