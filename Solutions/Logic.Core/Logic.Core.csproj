<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Logic.Core</AssemblyName>
    <RootNamespace>Template.Logic</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/_Project/Scripts/Logic/**/*.cs" LinkBase="Logic" />
    <Compile Include="../UnityShim/**/*.cs" LinkBase="UnityShim" />
    <!-- 只在纯 .NET 侧编译的 Logic 代码：用到 System.Text.Json 这类 Unity 没有的 BCL 类型的部分
         放这里，Unity 侧就不会因为找不到类型而编译失败（16a 实测踩到）。 -->
    <Compile Include="../LogicDotNet/**/*.cs" LinkBase="LogicDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.Mathematics">
      <HintPath>../../Tools/Deps/Unity.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
