{
  "abbreviationBlacklist": [
    "Mgr",
    "Cfg",
    "Svc",
    "Btn",
    "Idx",
    "Tmp",
    "Utils",
    "Ctx",
    "Param",
    "Attr",
    "Conf"
  ],
  "abbreviationExemptIdentifiers": [
    "paramName"
  ],
  "directoryNameBlacklist": [
    "misc",
    "common",
    "utils",
    "helper",
    "stuff",
    "temp",
    "new"
  ],
  "directoryNamePattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
  "documentLineLimit": 200,
  "documentExemptions": [
    "Doc/挂机任务书.md",
    "Doc/挂机日志.md",
    "Doc/改造方案.md",
    "Doc/JKFrameDoc/",
    "Doc/系统文档/",
    "Doc/正式化任务书.md",
    "Doc/正式化日志.md",
    "Doc/正式化清单.md"
  ],
  "changedPathWhitelist": [
    "Tools/",
    "Solutions/",
    "Packages/",
    "UnityProject/",
    "Pipelines/",
    "Config/",
    "Levels/",
    "Graphs/",
    "UI/",
    "Index/",
    "Memory/",
    "CLAUDE.md",
    "开始使用.md",
    "迁移清单.md",
    "reasonix.toml",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "Directory.Build.props"
  ],
  "testFileGlobs": [
    "Solutions/*.Tests/*.cs"
  ],
  "sourceScanSkipSegments": [
    "HybridCLRData",
    "PackageCache",
    "Build",
    "Logs"
  ],
  "genericNameBlacklist": [
    "RPG",
    "RebuiltRPG",
    "RebuiltRpg",
    "MyGame"
  ],
  "genericNameExemptPaths": [
    "Solutions/Gates.Tests/",
    "Solutions/Toolkit.Tests/"
  ],
  "playerBuildEntryMethod": "Template.Toolkit.Editor.PlayerBuildCommandLine.BuildWindows",
  "editorOwnedPathPrefixes": []
}
