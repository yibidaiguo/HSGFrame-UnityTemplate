    text: "\u56FE\u6CA1\u6709\u8FDB\u5165\u8282\u70B9\uFF08\u6BCF\u4E2A\u8282\u70B9\u90FD\u6709\u5165\u8FB9\u2014\u2014\u65E0\u5934\u73AF\uFF09"
  - key: val.noSingleEntry
    language: 1
    text: "\u56FE\u6CA1\u6709\u552F\u4E00\u8FDB\u5165\u70B9\uFF1A\u6709 {0} \u4E2A\u6839\u8282\u70B9\u6CA1\u6709\u5165\u8FB9\u2014\u2014\u628A\u5B83\u4EEC\u63A5\u5230\u540C\u4E00\u4E2A\u8FDB\u5165\u8282\u70B9\u4E4B\u4E0B\uFF0C\u6216\u6307\u5B9A\u4E00\u4E2A\u8FDB\u5165\u70B9"
  - key: val.noEntryEmpty
    language: 1
    text: "\u56FE\u6CA1\u6709\u8FDB\u5165\u8282\u70B9\uFF08entryInstanceIds \u4E3A\u7A7A\uFF09"
  - key: val.entryMissing
    language: 1
    text: "entryInstanceIds \u6307\u5411\u4E86\u4E0D\u5B58\u5728\u7684\u5B9E\u4F8B"
  - key: val.tickOneRoot
    language: 1
    text: "\u884C\u4E3A\u6811\u5FC5\u987B\u6070\u597D\u6709\u4E00\u4E2A\u6839\uFF08\u73B0\u6709
      {0} \u4E2A\uFF09"
  - key: val.tickStrictTree
    language: 1
    text: "\u884C\u4E3A\u6811\u5FC5\u987B\u662F\u4E25\u683C\u6811\uFF0C\u4F46\u8BE5\u8282\u70B9\u6709
      {0} \u4E2A\u7236\u8282\u70B9"
  - key: val.cycle
    language: 1
    text: "\u6210\u73AF\uFF1A\u8BE5\u8282\u70B9\u7684\u8FDE\u7EBF\u95ED\u5408\u4E86\u4E00\u4E2A\u56DE\u8DEF\uFF08\u6B64\u56FE\u7C7B\u578B\u8981\u6C42\u65E0\u73AF\uFF09"
  - key: val.edgeType
    language: 1
    text: "\u8FDE\u7EBF\u7C7B\u578B\u4E0D\u5339\u914D\uFF1A\u8F93\u51FA\u300C{0}\u300D\u4E0E\u8F93\u5165\u300C{1}\u300D\u4E0D\u517C\u5BB9"
  - key: val.providerNoWrite
    language: 1
    text: "\u53D6\u503C\u8282\u70B9\uFF08Provider\uFF09\u4E0D\u5F97\u5199\u9ED1\u677F\uFF08\u5B83\u58F0\u660E\u4E86\u5199\u5165\uFF09"
  - key: val.conditionNoWrite
    language: 1
    text: "\u6761\u4EF6\u8282\u70B9\uFF08Condition\uFF09\u4E0D\u5F97\u5199\u9ED1\u677F"
  - key: val.conditionOneOut
    language: 1
    text: "\u6761\u4EF6\u8282\u70B9\u5FC5\u987B\u6070\u597D\u6709\u4E00\u4E2A\u8F93\u51FA\u7AEF\u53E3\uFF08\u73B0\u6709
      {0} \u4E2A\uFF09"
  - key: val.conditionBoolOut
    language: 1
    text: "\u6761\u4EF6\u8282\u70B9\u7684\u552F\u4E00\u8F93\u51FA\u5FC5\u987B\u662F\u5E03\u5C14\uFF08Bool\uFF09"
  - key: val.controlNoWrite
    language: 1
    text: "\u7F16\u6392\u8282\u70B9\uFF08Control\uFF09\u4E0D\u5F97\u5199\u9ED1\u677F"
  - key: val.controlNoParams
    language: 1
    text: "\u7F16\u6392\u8282\u70B9\uFF08Control\uFF09\u4E0D\u5E94\u643A\u5E26\u6570\u636E\u53C2\u6570"
  - key: val.actionNoEffect
    language: 1
    text: "\u7EAF\u903B\u8F91\u52A8\u4F5C\u8282\u70B9\u6CA1\u6709\u4EFB\u4F55\u9ED1\u677F\u5199\u5165\uFF0C\u4E0D\u4EA7\u751F\u6548\u679C"
  - key: val.connOutInclude
    language: 1
    text: "'{0}.{1}' \u53EA\u80FD\u8FDE\u5230\uFF1A{2}\uFF08\u4E0D\u80FD\u8FDE\u5230
      '{3}'\uFF09"
  - key: val.connOutExclude
    language: 1
    text: "'{0}.{1}' \u4E0D\u80FD\u8FDE\u5230\uFF1A{2}\uFF08\u5F53\u524D\u8FDE\u5230\u4E86
      '{3}'\uFF09"
  - key: val.connInInclude
    language: 1
    text: "'{0}.{1}' \u53EA\u63A5\u53D7\u6765\u81EA\uFF1A{2}\uFF08\u4E0D\u80FD\u6765\u81EA
      '{3}'\uFF09"
  - key: val.connInExclude
    language: 1
    text: "'{0}.{1}' \u4E0D\u63A5\u53D7\u6765\u81EA\uFF1A{2}\uFF08\u5F53\u524D\u6765\u81EA
      '{3}'\uFF09"
