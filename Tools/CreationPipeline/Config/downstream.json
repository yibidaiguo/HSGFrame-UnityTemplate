{
  "_说明": "下游域路由表与实现表（决策 85）。域路由把 port 名指到 driver 名，实现表把实现名解析成可执行 + 参数。进 git；密钥一个都不许有，密钥值全在 local.json（决策 5）。参数里的路径是仓库相对，按仓库根展开。",
  "契约版本": "1.0.0",
  "域路由": {
    "生图": "comfyui",
    "模型生成": "tripo",
    "模型加工": "blender",
    "执行后端": "oaicompat",
    "需求编辑端": "feishu",
    "消息卡片": "feishu",
    "助手": "feishu"
  },
  "实现": {
    "bridge-comfyui": {
      "可执行": "dotnet",
      "参数": ["run", "--project", "Bridges/comfyui/src/BridgeComfyui", "--"]
    },
    "bridge-tripo": {
      "可执行": "dotnet",
      "参数": ["run", "--project", "Bridges/tripo/src/BridgeTripo", "--"]
    },
    "bridge-blender": {
      "可执行": "dotnet",
      "参数": ["run", "--project", "Bridges/blender/src/BridgeBlender", "--"]
    },
    "bridge-oaicompat": {
      "可执行": "dotnet",
      "参数": ["run", "--project", "Bridges/oaicompat/src/BridgeOaicompat", "--"]
    },
    "bridge-feishu": {
      "可执行": "dotnet",
      "参数": ["run", "--project", "Bridges/feishu/src/BridgeFeishu", "--"]
    }
  }
}
