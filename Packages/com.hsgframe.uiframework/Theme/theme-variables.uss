/* 只定主题变量，组件样式按需在各面板 USS 里长（方案模块 6：同一模式出现第 3 次才抽组件）。 */
:root {
    --颜色-主色: #4A90D9;
    --颜色-背景: #1E1E1E;
    --颜色-文本: #EAEAEA;
    --间距-小: 4px;
    --间距-中: 8px;
    --间距-大: 16px;
    --圆角-默认: 4px;
    --字号-正文: 14px;
    --字号-标题: 20px;

    /* 动效。**只有三档时长**，没有第四档——
       每个面板自己挑一个毫秒数的结果是整个界面节奏不齐，
       而那种不齐没人说得出哪里不对，只会觉得「有点廉价」。
       120ms 给指下就该有反应的（悬停、按下）；
       200ms 给出现与消失；320ms 只给整屏级的切换。 */
    --动效-快: 120ms;
    --动效-中: 200ms;
    --动效-慢: 320ms;

    /* 缓动只有两条：进场用「冲出去再稳住」，退场与状态变化用线性偏快。
       ease-out 系是给「东西出现」的——它一开始快，人眼先看到位置再看到停下；
       ease-in 系反过来，用在出现上会显得迟钝。 */
    --动效-进场缓动: ease-out;
    --动效-状态缓动: ease-in-out;

    /* 面板进场时先偏移这么多再滑回原位。**别调大**：
       超过 12px 就从「有反应」变成「在演动画」，开合频繁的界面里很快让人烦。 */
    --动效-进场位移: 8px;
}
