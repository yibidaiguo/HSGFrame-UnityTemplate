{
  "abbreviationBlacklist": [
    "Mgr",
    "Cfg",
    "Svc",
    "Btn",
    "Idx",
    "Tmp",
    "Utils",
    "Ctx",
    "Param",
    "Attr",
    "Conf"
  ],
  "abbreviationExemptIdentifiers": [
    "paramName"
  ],
  "directoryNameBlacklist": [
    "misc",
    "common",
    "utils",
    "helper",
    "stuff",
    "temp",
    "new"
  ],
  "directoryNamePattern": "^[A-Za-z][A-Za-z0-9_.]*$",
  "_underscoreExemptNames说明": "前三个是长期白名单（机器管理区，见 规范/结构规范-总纲.md 第三节第 1 条）；其余是迁移期的过渡名，迁一块删一条，名单燃尽即 R1 完工。",
  "underscoreExemptNames": [
    "_Inbox",
    "_Generated",
    "_Scratch",
    "_Project",
    "_tmp.PlaceholderCheck",
    "_sample_gen"
  ],
  "documentLineLimit": 200,
  "documentExemptions": [
    "Doc/挂机任务书.md",
    "Doc/挂机日志.md",
    "Doc/改造方案.md",
    "Doc/JKFrameDoc/",
    "Doc/系统文档/",
    "Doc/正式化任务书.md",
    "Doc/正式化日志.md",
    "Doc/正式化清单.md"
  ],
  "testFileGlobs": [
    "Solutions/*.Tests/*.cs"
  ],
  "sourceScanSkipSegments": [
    "HybridCLRData",
    "HybridCLRGenerate",
    "PackageCache",
    "Build",
    "Logs"
  ],
  "genericNameExemptPaths": [
    "Solutions/Gates.Tests/",
    "Solutions/Toolkit.Tests/"
  ],
  "playerBuildEntryMethod": "Template.Toolkit.Editor.PlayerBuildCommandLine.BuildWindows"
}
