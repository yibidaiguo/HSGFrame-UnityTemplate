// 发布流水线：夜间构建三步之后追加出包 stage，手动触发、打标归档。
// 触发时机：手动，按需打版本号。
// 失败意味着：发布产物不完整或归档失败，不能对外发版，需修复后重跑。
//
// 步骤与 Pipelines/pipelines.json 里的「发布」逐条对应。
// 出包入口方法名是每个项目自己的东西，同一个值也记在 gate-config.json 的 playerBuildEntryMethod。

pipeline {
    agent any
    stages {
        stage('dotnet build') {
            steps {
                bat 'dotnet build Solutions/Template.sln --nologo'
            }
        }
        stage('全量门禁') {
            steps {
                bat 'pwsh -NoProfile -File Tools/Gates/gate.ps1'
            }
        }
        stage('分钟级门禁') {
            steps {
                bat 'pwsh -NoProfile -File Tools/Gates/gate-unity.ps1 -TimeoutMinutes 40'
            }
        }
        // 需要 Unity：出 Windows 包。
        stage('出包') {
            steps {
                bat 'pwsh -NoProfile -File Tools/Cli/unity-cmd.ps1 -ExecuteMethod Template.Toolkit.Editor.PlayerBuildCommandLine.BuildWindows -TimeoutMinutes 60'
            }
        }
    }
}
