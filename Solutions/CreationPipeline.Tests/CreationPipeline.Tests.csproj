<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    AnimatedPreviewTests 直接拿 ImageSharp 读产出的 GIF 验帧，所以这里要显式挂一次。
    **内置依赖与 PackageReference 有一处不一样**：PackageReference 会顺着 ProjectReference
    传给上游工程，<Reference> 不会。所以谁用谁自己 Import，不能指望从被引的工程漏过来。
  -->
  <Import Project="../../Tools/Deps/props/ImageSharp.props" />

  <ItemGroup>
    <ProjectReference Include="../../Tools/CreationPipeline/CreationPipeline.csproj" />
    <!-- 飞书字段类型码住在桥里而不是引擎里（决策 11、93），所以测它要引桥工程。 -->
    <ProjectReference Include="../../Bridges/feishu/src/BridgeFeishu/BridgeFeishu.csproj" />
    <!-- 配方翻译器住在生图桥里（决策 84、87），测它要引桥工程。 -->
    <ProjectReference Include="../../Bridges/comfyui/src/BridgeComfyui/BridgeComfyui.csproj" />
    <!-- tripo 状态机与错误码映射住在模型生成桥里（决策 84、93），测它要引桥工程。 -->
    <ProjectReference Include="../../Bridges/tripo/src/BridgeTripo/BridgeTripo.csproj" />
  </ItemGroup>
</Project>
