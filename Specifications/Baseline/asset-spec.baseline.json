{
  "_说明": "资产规格基线：资产类型 → 默认规格 / 落点 / 命名模式 / 机检项。模板发，项目层与业务层就近覆盖。可覆盖清单之外的键只许收紧不许放宽（创作管线子文档 07 §二）。",
  "版本": "1.0.0",
  "资产类型": {
    "图标": {
      "域": "资产.生图",
      "规格": {
        "宽": 256,
        "高": 256,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/Art/Texture/Icon/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ]
    },
    "界面底图": {
      "域": "资产.生图",
      "规格": {
        "宽": 1080,
        "高": 1920,
        "格式": "PNG",
        "需要透明": false,
        "二次幂": false
      },
      "落点": "Assets/Game/Art/Texture/Ui/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高",
        "规格.需要透明"
      ],
      "_说明": "**竖屏**（手机）界面的底图。**底图不透明**——它是整屏最底下那一层，本来就该铺满、不镂空；透明底那条硬约束只管从它身上拆出来的 UI 元素。从前底图也写「需要透明」，结果每出一张底图都要在归一那步报一句「四角不同色，没敢抠透明」，那句话对底图毫无意义。PC / 横屏的界面用「PC界面底图」——尺寸是资产类型的属性，不是靠覆盖去掰的（覆盖只许收紧不许放宽，1080 掰不到 1920）。",
      "可拆图": true
    },
    "立绘": {
      "域": "资产.生图",
      "规格": {
        "宽": 1024,
        "高": 1024,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/Art/Texture/Character/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ]
    },
    "道具模型": {
      "域": "资产.模型",
      "规格": {
        "最大面数": 3000,
        "格式": "FBX",
        "单位": "米",
        "轴心": "中心",
        "最大材质数": 2,
        "贴图尺寸": 1024,
        "包围盒上限米": 5,
        "最大骨骼数": 0
      },
      "落点": "Assets/Game/Art/Model/Prop/",
      "命名模式": "^M_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.最大面数",
        "规格.最大材质数",
        "规格.贴图尺寸",
        "规格.最大骨骼数"
      ]
    },
    "角色模型": {
      "域": "资产.模型",
      "规格": {
        "最大面数": 15000,
        "格式": "FBX",
        "单位": "米",
        "轴心": "脚底",
        "最大材质数": 4,
        "贴图尺寸": 2048,
        "包围盒上限米": 3,
        "最大骨骼数": 120
      },
      "落点": "Assets/Game/Art/Model/Character/",
      "命名模式": "^M_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.最大面数",
        "规格.最大材质数",
        "规格.贴图尺寸",
        "规格.最大骨骼数"
      ]
    },
    "UI元素": {
      "域": "资产.生图",
      "_说明": "从界面设计图拆出来的单个元素（按钮、图标、面板底、进度条…）。一元素一张透明底 PNG，进模块的 UI 图集。层的来源是面板定义 UI/Definitions/<面板>.uidef.json 的元素清单。",
      "规格": {
        "宽": 512,
        "高": 512,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/Art/Texture/Ui/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高"
      ],
      "可拆图": false
    },
    "PC界面底图": {
      "域": "资产.生图",
      "_说明": "**横屏**（PC）界面的底图，同样**不透明**（理由见「界面底图」）。与「界面底图」分成两类而不是一类加尺寸覆盖：资产规格的覆盖只许收紧不许放宽，竖屏的 1080×1920 掰不成横屏的 1920×1080——那本来就是两种资产。",
      "规格": {
        "宽": 1920,
        "高": 1080,
        "格式": "PNG",
        "需要透明": false,
        "二次幂": false
      },
      "落点": "Assets/Game/Art/Texture/Ui/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "落点",
        "规格.宽",
        "规格.高",
        "规格.需要透明"
      ],
      "可拆图": true
    },
    "帧动画": {
      "域": "资产.生图",
      "规格": {
        "宽": 512,
        "高": 512,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": true
      },
      "落点": "Assets/Game/Art/Texture/Effect/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "规格",
        "规格.宽",
        "规格.高"
      ],
      "_说明": "帧动画的逐帧图与拼好的精灵图集。落 Effect/ 是因为通用帧动画绝大多数是特效；人物那一路单列一类，落 Character/。帧本身与图集都算这一类——它们是同一段动画的两种形态，分成两类的话「这段动画归谁」会有两个答案。"
    },
    "人物帧动画": {
      "域": "资产.生图",
      "规格": {
        "宽": 512,
        "高": 768,
        "格式": "PNG",
        "需要透明": true,
        "二次幂": false
      },
      "落点": "Assets/Game/Art/Texture/Character/",
      "命名模式": "^T_[A-Za-z0-9]+$",
      "可覆盖": [
        "规格",
        "规格.宽",
        "规格.高",
        "规格.二次幂"
      ],
      "_说明": "2D 人物帧动画：走图生图，每帧从同一张参考图出发。二次幂缺省关掉——人物是竖长的，硬凑二次幂会在上下留出大片空白，而图集是按最大帧留格的。"
    }
  },
  "_可拆图说明": "这一类资产出来的图能不能按元素拆成单图。**显式声明，不按类型名猜**——按名字前缀猜过一次，「PC界面底图」以 PC 开头，判据写的是「界面」开头，当场漏掉。整屏的界面图才谈得上拆；图标、立绘、以及已经拆出来的 UI元素 本身没有层。"
}