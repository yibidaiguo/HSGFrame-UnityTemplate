<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Toolkit.CommandHost</AssemblyName>
    <RootNamespace>Template.Toolkit.CommandHost</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CommandFramework/CommandFramework.csproj" />
    <ProjectReference Include="../../ConfigBridge/ConfigBridge.csproj" />
    <ProjectReference Include="../../Gates/Gates.csproj" />
    <ProjectReference Include="../../UiScaffold/UiScaffold.csproj" />
    <ProjectReference Include="../../Indexing/Indexing.csproj" />
    <ProjectReference Include="../../AssetPipeline/AssetPipeline.csproj" />
    <ProjectReference Include="../../Scaffold/ProjectScaffold.csproj" />
    <ProjectReference Include="../../CodeGen/CodeGen.csproj" />
    <!-- 热更是可选功能：整个 Tools/Hotfix/ 被摘掉时这条引用自动失效，
         hotfix.* 四条命令随之从 toolkit-cmd list 里消失，命令层不用改一行。 -->
    <ProjectReference Include="../../Hotfix/Hotfix.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)../../Hotfix/Hotfix.csproj')" />
    <ProjectReference Include="../../FileServer/FileServer.csproj" />
    <ProjectReference Include="../../Dashboard/Dashboard.csproj" />
  </ItemGroup>
</Project>
