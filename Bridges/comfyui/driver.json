{
  "名称": "comfyui",
  "port": [
    "生图"
  ],
  "形态": "本地",
  "契约版本": ">=1.0 <2.0",
  "配置schema": {
    "地址": {
      "类型": "string",
      "默认": "http://127.0.0.1:8188"
    },
    "超时秒": {
      "类型": "number",
      "默认": 300
    },
    "安装目录": {
      "类型": "string",
      "默认": "",
      "_说明": "ComfyUI 的根目录，也就是 custom_nodes 的上一级。留空表示没配，scripts/ 下的脚本包就装不了、装机页也只能记「未验」。这一格要的是**本机磁盘路径**，与上面那个 HTTP「地址」互相推不出来：远程 ComfyUI 装不了脚本包，那台机器得自己装一次。值只进本机的 local.json，永远不进仓库（决策 5）。"
    }
  },
  "密钥字段": [],
  "试跑": "bridge.probe --Driver comfyui",
  "能力探测": "bridge.probe --Driver comfyui",
  "实现": "bridge-comfyui",
  "字段类型映射": {},
  "表单分组字段": ""
}
